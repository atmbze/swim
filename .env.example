# Copy to .env (never commit .env). No secrets are required for the MVP.
# SQLite file path (default ./data/swim.db)
DATABASE_PATH=./data/swim.db
# Where validated uploads are stored (default ./data/uploads)
UPLOAD_DIR=./data/uploads
# bcrypt cost factor (default 10)
BCRYPT_COST=10
# Password used by `npm run seed` for demo accounts (dev only)
SEED_PASSWORD=password123
# Set to 1 ONLY for local `next start` over plain http (disables Secure cookie flag)
INSECURE_COOKIES=
# Rate limits (per minute per email for login, x3 per IP; per 10 min per IP for register)
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
