# Copy to .env (never commit .env). Placeholders only — no real secrets in this file.
#
# === Local development (current SQLite build) ===
# SQLite file path (default ./data/swim.db)
DATABASE_PATH=./data/swim.db
# Where validated uploads are stored locally (default ./data/uploads)
UPLOAD_DIR=./data/uploads
#
# === Staging (Vercel + Neon Postgres + Cloudflare R2 — see docs/staging.md) ===
# Neon POOLED connection string — used by the app for all request-path queries.
# DATABASE_URL=postgres://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Neon DIRECT (unpooled) connection string — migrations and seed ONLY.
# DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require
# Cloudflare R2 (S3-compatible) photo storage.
# R2_ACCOUNT_ID=<cloudflare-account-id>
# R2_ACCESS_KEY_ID=<r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# R2_BUCKET=swim-staging-images
# Public base URL where R2 images are served (also add this origin to CSP img-src).
# R2_PUBLIC_BASE_URL=https://images-staging.example.com
# Seed guard: the seed script must refuse to run against a hosted DB unless this is 1.
# ALLOW_STAGING_SEED=
#
# === Shared ===
# bcrypt cost factor (default 10)
BCRYPT_COST=10
# Password used by `npm run seed` for demo accounts (dev/staging only — never reuse in prod)
SEED_PASSWORD=<redacted>
# Set to 1 ONLY for local `next start` over plain http (disables Secure cookie flag).
# Must stay EMPTY on staging/production (they are HTTPS).
INSECURE_COOKIES=
#
# === Platform fee (decided 2026-11-21 — config only until the Stripe step reads it) ===
# 990 bps = 9.9% flat on SHIPPED sales, all-in (Stripe processing comes out of the 9.9;
# no listing fee, no per-order fee). Fee base = item price + shipping charged, never tax.
PLATFORM_FEE_BPS=990
# 0 bps = 0% on LOCAL pickup.
PLATFORM_FEE_LOCAL_BPS=0
# Premium sellers (decided 2026-11-21): 690 bps = 6.9% on SHIPPED sales.
PLATFORM_FEE_PREMIUM_BPS=690
# Premium subscription price: $14.99/mo (annual $149.99) — Stripe price created in the Stripe step.
PREMIUM_PRICE_CENTS=1499
